                <a href="/fiesta">próxima fiesta</a>.
              </p>
              <a href="/" class="btn btn-primary mt-3">Ir al inicio</a>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- Not Found Area End -->

    <!-- Include Footer -->
    <%- include('partials/store_footer') -%>

    <!-- Include Java Script -->
